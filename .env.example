TARGET_API_URL=https://api地址/v1/chat/completions
TARGET_API_KEY=你的APIKey
# Claude 原生 Messages API（保留 prompt cache）：Kelivo 选 Claude 类型供应商时走 /v1/messages
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# 留空时回退使用 TARGET_API_KEY
ANTHROPIC_API_KEY=
# 自动唤醒用哪种上游格式：openai（默认，走 TARGET_API_URL）或 anthropic（走 ANTHROPIC_API_URL）
WAKE_API_FORMAT=openai
# anthropic 模式下唤醒回复的 max_tokens（Claude 的思考也计入这里）
WAKE_MAX_TOKENS=4000
# anthropic 模式下唤醒缓存（人设 + 聊天记录）的时长：留空为默认 5 分钟，填 1h 为一小时缓存；检查间隔要短于它才命中得上
WAKE_CACHE_TTL=1h
# anthropic 模式下唤醒时最多带多少条最近的聊天记录（控制 token 用量）
WAKE_HISTORY_MESSAGES=40
GATEWAY_API_KEY=公网访问网关时使用的长随机Key
MODEL_NAME=你的模型名称
BARK_KEY=你的BarkKey
CUSTOM_ICON_URL=https://你的图标URL（可选）
ALLOW_PUBLIC_API=false
PUSH_PROVIDER=bark
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_PRIORITY=
NTFY_TAGS=
DIARY_ENABLED=true
DIARY_DIR=diary
DATA_DIR=
PUSH_TIMEOUT_MS=15000
WAKE_UPSTREAM_TIMEOUT_MS=300000
REQUEST_BODY_LIMIT_MB=50
MULTIMODAL_MODE=passthrough
DAY_WAKE_AFTER_MINUTES=60
NIGHT_WAKE_AFTER_MINUTES=120
DAY_CHECK_INTERVAL_MINUTES=10
NIGHT_CHECK_INTERVAL_MINUTES=120
# 随机唤醒时刻（默认 0 = 关闭，和旧版完全一样）
# 每次检查间隔在“基础间隔 ± 抖动”之间随机，最少 1 分钟
DAY_CHECK_INTERVAL_JITTER_MINUTES=0
NIGHT_CHECK_INTERVAL_JITTER_MINUTES=0
# 随机后的检查间隔上限（白天夜间都生效），留空不限制；用 1 小时缓存时建议填 57
WAKE_INTERVAL_MAX_MINUTES=
# 沉默阈值额外随机推迟 0~N 分钟，每段沉默只抽一次，让第一次主动联系落在随机时刻
WAKE_AFTER_JITTER_MINUTES=0
WAKE_DAY_START_HOUR=10
WAKE_DAY_END_HOUR=24
WEATHER_ENABLED=false
WEATHER_LOCATION_NAME=Beijing
WEATHER_LAT=
WEATHER_LON=
WEATHER_UNITS=metric
PORT=3000
GATEWAY_BASE_URL=http://localhost:3000
TIME_ZONE=Asia/Shanghai
RESTART_COMMAND=pm2 restart gateway wake-up --update-env
ADMIN_USER=admin
ADMIN_PASSWORD=你的强密码
